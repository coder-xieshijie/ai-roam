    {
      "slug": "dev-skills",
      "name": "dev-skills",
      "type": "REQUIREMENT TO PR",
      "summary": "从需求到验证过、可合入的 PR：一套给编程 Agent 用的 Skills。",
      "detail": "先给仓库搭一个 Agent 能自己启动、操作、观察的验证环境；之后每个需求由一个 Agent 从头做到尾，在运行的应用里证明结果，再由另一家模型独立验证。人只在三处介入：确认决定，确认验收标准，合入前读一遍决定清单。",
      "repo": "https://github.com/coder-xieshijie/dev-skills",
      "revision": "2254db66bfd8f1baa50eb76fe5ca7875905ada56",
      "updated": "2026-10-13",
      "updateNote": "dev-skills · 更新为从需求到可合入 PR 的流程",
      "catalog": [
        {
          "name": "repo-readiness",
          "group": "flow",
          "step": "A 仓库准备",
          "title": "让 Agent 能自己验证",
          "description": "每个仓库做一次。搭好项目自己的验证 Skill：Agent 能在 worktree 里隔离地启动、操作、观察应用；配上带判据编号的功能地图、场景脚本、冒烟集，以及 CI 里的结构检查。仓库里查不到的事，一次问清。",
          "you": "每个仓库一次，回答仓库里查不到的事",
          "example": "/dev-skills:repo-readiness 下一个需求是 <链接或原文>"
        },
        {
          "name": "core-grill",
          "group": "flow",
          "step": "B 定义",
          "title": "把要你定的事问清楚",
          "description": "需求开始时逐轮追问会改变用户可见结果的决定，比如交互、文案、默认值、入口、数据会不会丢。每个问题给出选项、后果和推荐答案；实现细节由 Agent 自己定，记成默认决定。最后整理成一份决定汇总。",
          "you": "回答问题，确认一次决定汇总",
          "example": "/dev-skills:core-grill 需求是 <链接或原文>，需求文档放 <需求目录>/"
        },
        {
          "name": "core-spec",
          "group": "flow",
          "step": "B 定义",
          "title": "写下决定和验收标准",
          "description": "把决定汇总收敛成 spec.md（决定与约束）和 verify.md（验收要求），请另一家模型逐条查漏。确认后两份文件冻结，提交到需求分支，开 Draft PR。也可以只产出 spec。",
          "you": "确认一次 spec 和 verify",
          "example": "/dev-skills:core-spec 依据决定汇总写 spec.md 和 verify.md"
        },
        {
          "name": "deliver",
          "group": "flow",
          "step": "C 交付",
          "title": "一个 Agent 做到可合入",
          "description": "依据冻结的 spec 和 verify，由一个 owner 逐个里程碑实现，并在运行的应用里跑场景。要定的事先问另一家模型，再自己决定，列进 PR 最前面的决定清单。最后由另一家模型对最终代码独立验证，处理完 CI 和评审，做到可合入。",
          "you": "合入前读决定清单，然后合入",
          "example": "/dev-skills:deliver 接手 <Draft PR 链接>"
        },
        {
          "name": "review-rules",
          "group": "support",
          "title": "让评审有依据",
          "description": "评审代码与设计、复核评审意见、判断修复方案时用的五条准则：正确完整、最小必要改动、复杂度与收益相称、足够的扩展性、责任边界清楚。",
          "example": "/dev-skills:review-rules 复核这条评审意见，说明依据和最小修复"
        },
        {
          "name": "mr-for-human",
          "group": "support",
          "title": "读懂 AI 写的代码",
          "description": "把 PR 整理成给人看的阅读指南：先给核心结论和需要判断的事，再讲设计、用伪代码写出的执行逻辑和运行约束，最后给出代码定位。",
          "example": "/dev-skills:mr-for-human 带我读懂这个 PR：<链接>"
