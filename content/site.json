    {
      "slug": "agent-lord",
      "name": "Agent Lord",
      "type": "AGENT ORCHESTRATION",
      "summary": "这条工作流的起点：一个在主会话里调度多个编程 Agent 的工具。",
      "detail": "8 月写成，把任务派给 Claude Code、Codex 和 MCode，让它们并行干活、互相评审，每一步都有记录。用下来发现，卡住交付的不是 Agent 不够多：它们没法自己运行产品来证明做对了，已经定下的事也会在一次次交接中丢失。9 月底起，新需求改走 dev-skills 的流程。",
      "repo": "https://github.com/coder-xieshijie/agent-lord",
      "revision": "775bc882b82fe13c5863440c05fbf08272c830c7",
      "updated": "2026-10-13",
      "updateNote": "Agent Lord · 介绍改为这条工作流的起点",
      "workflows": [
        {
          "slug": "cross-review",
          "name": "交叉评审",
          "description": "MCode 与 Codex 先各自独立评审，再交换结论互相质证；最后由一个新的 MCode 会话逐项独立裁决。流程是否走完、代码有没有问题，分开报告。"
        },
        {
          "slug": "plan-cross-review",
          "name": "计划交叉评审",
          "description": "两个评审者交叉质证后，由一个新的复核者核对问题与方案，并重写完整计划；再由另一个新会话对照需求与源码验证。作者不自查最终文档。"
        },
        {
          "slug": "plan-to-implement",
          "name": "计划到实现",
          "description": "写代码前先定下验收场景；按计划阶段在一条分支上顺序实现，每个阶段一个会话；最后的评审和验收跑在同一个 head 上。获得授权后，每个仓库开或更新一个 PR/MR；流程不会合入。"
        }
      ]
    }
