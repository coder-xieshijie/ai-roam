[Unit]
Description=Publish a sanitized Obsidian LiveSync status snapshot
After=network-online.target obsidian-livesync-couchdb.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/update-obsidian-sync-status
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/www/obsidian-status /var/lib/obsidian-status
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
